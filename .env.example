# .env.example - Milestone 4: Environment Configuration Template
"""
Copy this file to .env and fill in your environment-specific values
Never commit .env files to version control
"""

# ========== APPLICATION =========
ENV=development
LOG_LEVEL=INFO
DEBUG=False

# ========== DATABASE ==========
# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-secure-password-here
DB_NAME=sports_injury_db
DATABASE_URL=postgresql://postgres:password@localhost:5432/sports_injury_db

# ========== AUTHENTICATION ==========
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========== REDIS CACHE ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# ========== EMAIL SERVICE ==========
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@sports-injury-detection.com
SMTP_FROM_NAME=Sports Injury Detection

# ========== FILE STORAGE ==========
UPLOAD_DIR=./uploaded_videos
MAX_UPLOAD_SIZE_MB=500
REPORTS_DIR=./generated_reports
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov,.mkv

# ========== AWS S3 (Optional) ==========
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=sports-injury-videos
AWS_S3_VIDEOS_PREFIX=uploads/
AWS_S3_REPORTS_PREFIX=reports/

# ========== API KEYS ==========
# Third-party API keys for integrations
SENDGRID_API_KEY=your-sendgrid-key
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token

# ========== MONITORING & LOGGING ==========
# Sentry Error Tracking
SENTRY_DSN=

# CloudWatch Logs
CLOUDWATCH_LOG_GROUP=/sports-injury/api
CLOUDWATCH_REGION=us-east-1

# ========== SECURITY ==========
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1

# ========== RATE LIMITING ==========
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ========== ANALYSIS PARAMETERS ==========
# Biomechanical analysis thresholds
MIN_FRAMES_FOR_ANALYSIS=30
MIN_CONFIDENCE_SCORE=0.7
SYMMETRY_THRESHOLD=50
POSTURE_STABILITY_THRESHOLD=40
KNEE_VALGUS_RISK_THRESHOLD=60

# ========== DEPLOYMENT ==========
# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
WORKERS=4

# Frontend URL
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ========== TESTING ==========
TESTING_MODE=False
TEST_DATABASE_URL=sqlite:///./test.db
